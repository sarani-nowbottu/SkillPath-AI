# SkillPath AI Environment Configuration
FLASK_SECRET_KEY=skillpath-ai-dev-secret-key-change-in-production
FLASK_PORT=5000
FLASK_DEBUG=True

# AI Mentor Provider Configuration
# Supported providers: "none" (offline rule-based mentor), "groq", "gemini", "openai"
AI_PROVIDER=none
AI_API_KEY=your_api_key_here
AI_MODEL=

# If using Groq:
# AI_PROVIDER=groq
# AI_API_KEY=gsk_...
# AI_MODEL=llama-3.3-70b-versatile

# If using Google Gemini:
# AI_PROVIDER=gemini
# AI_API_KEY=AIzaSy...
# AI_MODEL=gemini-1.5-flash

# If using OpenAI:
# AI_PROVIDER=openai
# AI_API_KEY=sk-...
# AI_MODEL=gpt-4o-mini
